<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MeetingCapture.TrayApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingCapture.TrayApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Meeting Capture">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" CornerRadius="8" RowSpacing="0">
        <Grid.Resources>
            <local:CompletionTextDecorationsConverter x:Key="CompletionTextDecorationsConverter"/>
            <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <DataTemplate x:Key="MeetingRowTemplate">
                <Grid ColumnSpacing="8" Padding="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Subject}" TextWrapping="Wrap" MaxLines="2"
                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Subject}"/>
                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding DetailsText}" TextWrapping="Wrap" MaxLines="2"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Record" Click="OnMeetingRecordClick"
                            VerticalAlignment="Center" Padding="10,6"
                            AutomationProperties.Name="{Binding AccessibleName}"/>
                </Grid>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="ParticipantChipPanel">
                <StackPanel Orientation="Horizontal" Spacing="6"/>
            </ItemsPanelTemplate>
            <DataTemplate x:Key="ParticipantChipTemplate">
                <Border Width="30"
                        Height="30"
                        CornerRadius="15"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="{Binding DisplayName}"
                        AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Initials}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="CatchUpSectionTemplate">
                <StackPanel Spacing="4"
                            Margin="0,0,0,12"
                            AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Heading}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Margin="0,1"
                                           TextWrapping="Wrap"
                                           LineHeight="20"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
            <Style x:Key="RecordingInsightExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
            <Style x:Key="RecordingStatusTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="12,2,12,8"/>
            </Style>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SettingsFieldDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PrimaryContentColumn" Width="*"/>
            <ColumnDefinition x:Name="TopicMapColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header (shared) ─────────────────────────────────────────── -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="16,10,16,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                ToolTipService.ToolTip="Drag to move the Meeting Capture window"
                AutomationProperties.Name="Meeting Capture window header. Drag to move the window.">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                          Glyph="&#xE916;"
                          FontSize="16"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Meeting Capture"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="Drag to move the Meeting Capture window"
                           AutomationProperties.Name="Meeting Capture. Drag to move the window."
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel x:Name="TitleBarActions"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <InfoBadge x:Name="RecordingBadge"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               Style="{StaticResource CriticalValueInfoBadgeStyle}">
                        <InfoBadge.IconSource>
                            <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" FontSize="10"/>
                        </InfoBadge.IconSource>
                    </InfoBadge>
                    <TextBlock x:Name="StatusText"
                               Text="Idle"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="160"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border x:Name="AiActivityIndicator"
                            Visibility="Collapsed"
                            MaxWidth="150"
                            Padding="6,3"
                            CornerRadius="4"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            ToolTipService.ToolTip="{Binding Text, ElementName=AiActivityHeaderText}">
                        <TextBlock x:Name="AiActivityHeaderText"
                                   Text="AI idle · No activity"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   AutomationProperties.Name="AI idle. No activity."/>
                    </Border>
                    <TextBlock x:Name="AiActivityAnnouncementText"
                               Width="1"
                               Height="1"
                               Opacity="0"
                               IsHitTestVisible="False"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="ContextButton"
                            Width="28" Height="28"
                            Padding="0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Related context and participants"
                            AutomationProperties.Name="Related context and participants">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE8F1;"
                                  FontSize="13"/>
                        <Button.Flyout>
                            <Flyout x:Name="ContextFlyout"
                                    Placement="BottomEdgeAlignedRight"
                                    Opening="OnContextFlyoutOpening">
                                <Grid Width="400" MaxHeight="520">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2" Margin="0,0,0,10">
                                        <TextBlock Text="Meeting context"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        <TextBlock Text="Related suggestions and verified participant information"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Related suggestions"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <ProgressRing x:Name="RelatedContextProgress"
                                                              Grid.Column="1"
                                                              Width="18"
                                                              Height="18"
                                                              IsActive="False"
                                                              Visibility="Collapsed"/>
                                                <Button x:Name="RelatedContextRefreshButton"
                                                        Grid.Column="2"
                                                        MinHeight="32"
                                                        Padding="10,4"
                                                        Content="Refresh suggestions"
                                                        Click="OnRelatedContextRefreshClick"
                                                        AutomationProperties.Name="Refresh related suggestions"/>
                                            </Grid>
                                            <TextBlock Text="Suggestions from WorkIQ are not verified meeting facts."
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="RelatedContextStatusText"
                                                       Text="Waiting for a discussion topic."
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                            <Expander x:Name="RelatedContextTopicExpander"
                                                      Visibility="Collapsed"
                                                      IsExpanded="False"
                                                      HorizontalAlignment="Stretch">
                                                <Expander.Header>
                                                    <TextBlock x:Name="RelatedContextTopicText"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                </Expander.Header>
                                                <TextBlock x:Name="RelatedContextTopicDisclosureText"
                                                           Margin="0,4,0,2"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Expander>
                                            <ItemsControl x:Name="RelatedContextList"
                                                          Visibility="Collapsed">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="0,5,0,9">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxLines="2"
                                                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                    <TextBlock Text="{Binding Metadata}"
                                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               TextWrapping="Wrap"
                                                                               MaxLines="3"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Tag="{Binding Url}"
                                                                        Click="OnOpenContextSourceClick"
                                                        IsEnabled="{Binding CanOpen}"
                                                                        Width="36"
                                                                        Height="36"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="Open externally"
                                                                        AutomationProperties.Name="{Binding ExternalActionName}">
                                                                    <FontIcon Glyph="&#xE8A7;"
                                                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                              FontSize="13"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Participants"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                <ProgressRing x:Name="RosterProgress"
                                                              Grid.Column="1"
                                                              Width="18"
                                                              Height="18"
                                                              IsActive="False"
                                                              Visibility="Collapsed"/>
                                                <Button x:Name="RosterRefreshButton"
                                                        Grid.Column="2"
                                                        MinHeight="32"
                                                        Padding="10,4"
                                                        Content="Refresh roster"
                                                        Click="OnRosterRefreshClick"
                                                        AutomationProperties.Name="Refresh verified live roster"/>
                                            </Grid>
                                            <TextBlock x:Name="RosterStatusText"
                                                       Text="Live roster has not been checked."
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                            <StackPanel x:Name="LiveParticipantsPreview"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="Verified joined participants">
                                                <ItemsControl x:Name="LiveParticipantsList"
                                                              ItemTemplate="{StaticResource ParticipantChipTemplate}"
                                                              ItemsPanel="{StaticResource ParticipantChipPanel}"/>
                                                <TextBlock x:Name="LiveParticipantsOverflowText"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="RosterFreshnessText"
                                                       Visibility="Collapsed"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="RosterLimitationText"
                                                       Visibility="Collapsed"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <TextBlock x:Name="ScheduledInviteesSummaryText"
                                                       Margin="0,4,0,0"
                                                       Text="No scheduled invitees are available."
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel x:Name="ScheduledInviteesPreview"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="Scheduled invitees">
                                                <ItemsControl x:Name="ScheduledInviteesList"
                                                              ItemTemplate="{StaticResource ParticipantChipTemplate}"
                                                              ItemsPanel="{StaticResource ParticipantChipPanel}"/>
                                                <TextBlock x:Name="ScheduledInviteesOverflowText"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <Expander x:Name="ScheduledInviteesExpander"
                                                      Visibility="Collapsed"
                                                      IsExpanded="False"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch">
                                                <Expander.Header>
                                                    <TextBlock Text="All scheduled invitees"
                                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                                </Expander.Header>
                                                <TextBlock x:Name="ScheduledInviteesAllText"
                                                           Margin="0,4,0,2"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Expander>

                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AiUsageStatusText"
                                                           Text="No AI activity has occurred in this recording."
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <HyperlinkButton x:Name="AiDiagnosticsLink"
                                                                 Grid.Column="1"
                                                                 Padding="4,0"
                                                                 Content="AI diagnostics"
                                                                 Click="OnOpenAiDiagnosticsClick"
                                                                 ToolTipService.ToolTip="Open Settings, AI diagnostics"
                                                                 AutomationProperties.Name="Open AI diagnostics in Settings"/>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="OpenVisualizationButton"
                            Width="28" Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Open saved meeting visualization"
                            AutomationProperties.Name="Open saved meeting visualization"
                            Click="OnOpenVisualizationClick">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE8E5;"
                                  FontSize="13"/>
                    </Button>
                    <ToggleButton x:Name="TopicMapToggleButton"
                                  Width="28" Height="28"
                                  Padding="0"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Show meeting visualization"
                                  AutomationProperties.Name="Show meeting visualization"
                                  Click="OnTopicMapToggleClick">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE8F2;"
                                  FontSize="13"/>
                    </ToggleButton>
                    <Button x:Name="RecordingSettingsButton"
                            Width="28" Height="28"
                            Padding="0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Recording settings"
                            AutomationProperties.Name="Recording settings"
                            Click="OnPreferencesClick">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE713;"
                                  FontSize="13"/>
                    </Button>
                    <ToggleButton x:Name="PinButton"
                                  Width="28" Height="28"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Pin panel open"
                                  AutomationProperties.Name="Pin panel above other windows"
                                  Click="OnPinClick">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE718;"
                                  FontSize="13"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════ STATE 1: IDLE ════════════════ -->
        <Grid x:Name="IdlePanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="CalendarScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Around now" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <Button Grid.Column="1" Click="OnRefreshCalendarClick" Padding="8,4"
                                ToolTipService.ToolTip="Refresh meetings" AutomationProperties.Name="Refresh meetings">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="CalendarStatusText" Text="Connecting calendar..."
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <Border x:Name="CalendarSection">
                        <ItemsControl x:Name="TodaysMeetingsList" ItemTemplate="{StaticResource MeetingRowTemplate}"/>
                    </Border>
                    <Expander x:Name="OtherMeetingsExpander" Header="Rest of today" IsExpanded="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsControl x:Name="OtherMeetingsList" ItemTemplate="{StaticResource MeetingRowTemplate}"/>
                    </Expander>
                    <Expander x:Name="PastMeetingsExpander" Header="Earlier today" IsExpanded="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ItemsControl x:Name="PastMeetingsList" ItemTemplate="{StaticResource MeetingRowTemplate}"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Start Recording (full width) -->
            <Button x:Name="StartButton"
                    Grid.Row="1"
                    Margin="16,8,16,8"
                    HorizontalAlignment="Stretch"
                    Padding="12,10"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnStartClick">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="14"/>
                    <TextBlock Text="Start Recording" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Button>

            <!-- Open Notes / Settings -->
            <Grid Grid.Row="2"
                  Padding="16,8,16,14"
                  ColumnSpacing="8"
                  BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenFolderButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Padding="10,6"
                        Click="OnOpenFolderClick">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xED25;" FontSize="14"/>
                        <TextBlock Text="Open Notes" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Padding="10,6"
                        Click="OnPreferencesClick">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock Text="Settings" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="PreferencesPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="16,10" Orientation="Horizontal" Spacing="12">
                <Button Content="Back" Click="OnPreferencesBackClick"/>
                <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Button x:Name="PreferencesStopButton" Content="Stop recording"
                        Visibility="Collapsed" Click="OnStopClick"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" Spacing="12">
                    <Expander Header="Calendar" IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="0,4,0,8">
                            <TextBlock x:Name="WorkIqStateText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="WorkIqSignInButton" Content="Sign in to WorkIQ" Click="OnWorkIqSignInClick"/>
                                <Button x:Name="WorkIqCancelButton" Content="Cancel" Visibility="Collapsed" Click="OnWorkIqCancelClick"/>
                                <Button x:Name="WorkIqSignOutButton" Content="Sign out" Visibility="Collapsed" Click="OnWorkIqSignOutClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Audio" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="0,4,0,8">
                            <Button x:Name="PreviewButton" Content="Start audio preview" Click="OnPreviewClick"/>
                            <TextBlock Text="Microphone"/>
                            <ProgressBar x:Name="MicrophoneMeter" Minimum="0" Maximum="1" IsEnabled="False"
                                         AutomationProperties.Name="Microphone preview level"/>
                            <TextBlock Text="System audio"/>
                            <ProgressBar x:Name="LoopbackMeter" Minimum="0" Maximum="1" IsEnabled="False"
                                         AutomationProperties.Name="System audio preview level"/>
                            <Expander Header="Diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="PreviewHealthText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock x:Name="HealthText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Expander>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Capture microphone" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="Record audio from the default microphone." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <ToggleSwitch x:Name="CaptureMic" OnContent="On" OffContent="Off"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Capture system audio" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="Record meeting audio played through Windows." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <ToggleSwitch x:Name="CaptureLoopback" OnContent="On" OffContent="Off"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Meeting suggestions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Padding="0,4,0,8">
                            <Button Content="Snooze for 30 minutes" Click="OnSnoozeClick"/>
                            <Button Content="Resume suggestions" Click="OnResumeDetectionClick"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Transcription" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6" Padding="0,4,0,8">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Endpoint" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="Azure Cognitive Services endpoint URL" Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <TextBox x:Name="TEndpoint" PlaceholderText="https://resource.cognitiveservices.azure.com/"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Region" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="Azure region, for example swedencentral." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <TextBox x:Name="TRegion"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Language" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="BCP-47 language tag for transcription." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <TextBox x:Name="TLanguage" PlaceholderText="en-US"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="API key" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="Leave blank to keep the existing key." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <PasswordBox x:Name="TApiKey"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Intelligence" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6" Padding="0,4,0,8">
                            <TextBlock Text="Changes apply to new requests after saving. Test synthesis and live intelligence separately. Environment and user-secret overrides take precedence."
                                       TextWrapping="Wrap"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Provider" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="GitHub Copilot uses your gh CLI login. Azure OpenAI requires an endpoint and key."
                                               Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <ComboBox x:Name="IProvider" SelectionChanged="OnProviderChanged">
                                        <ComboBoxItem Content="GitHub Copilot" Tag="github"/>
                                        <ComboBoxItem Content="Azure OpenAI (BYOC)" Tag="azure"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="GitHubIntelligenceFields" Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CopilotModelCatalogStatus"
                                               Text="Available account models load when settings open."
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsFieldDescriptionStyle}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <Button x:Name="RefreshCopilotModelsButton"
                                            Grid.Column="1"
                                            Content="Refresh models"
                                            AutomationProperties.Name="Refresh available GitHub Copilot models"
                                            Click="OnRefreshCopilotModelsClick"/>
                                </Grid>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Synthesis model" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <TextBlock Text="Converts the transcript to structured notes." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                        <ComboBox x:Name="ISynthesisModel"
                                                  HorizontalAlignment="Stretch"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Id"
                                                  AutomationProperties.Name="Synthesis model"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="GhTestSynthesisBtn" Content="Test synthesis" Click="OnTestSynthesisClick"/>
                                            <TextBlock x:Name="GhTestSynthesisResult" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Intelligence model" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <TextBlock Text="Used for live topic, catch-up, questions, and actions." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                        <ComboBox x:Name="IIntelligenceModel"
                                                  HorizontalAlignment="Stretch"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Id"
                                                  AutomationProperties.Name="Intelligence model"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="GhTestIntelligenceBtn" Content="Test intelligence" Click="OnTestIntelligenceClick"/>
                                            <TextBlock x:Name="GhTestIntelligenceResult" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="AzureIntelligenceFields" Spacing="6" Visibility="Collapsed">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Endpoint" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <TextBox x:Name="IEndpoint" PlaceholderText="https://resource.openai.azure.com/"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="API version" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <TextBox x:Name="IApiVersion"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="API key" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <TextBlock Text="Leave blank to keep the existing key." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                        <PasswordBox x:Name="IApiKey"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Synthesis deployment" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <TextBox x:Name="ISynthesisDeployment"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="AzTestSynthesisBtn" Content="Test synthesis" Click="OnTestSynthesisClick"/>
                                            <TextBlock x:Name="AzTestSynthesisResult" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Intelligence deployment" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                        <TextBox x:Name="IIntelligenceDeployment"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="AzTestIntelligenceBtn" Content="Test intelligence" Click="OnTestIntelligenceClick"/>
                                            <TextBlock x:Name="AzTestIntelligenceResult" Visibility="Collapsed" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AiDiagnosticsExpander"
                              Header="AI diagnostics"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10" Padding="0,4,0,8">
                            <TextBlock Text="Inspect in-memory AI and WorkIQ request metadata for this app session."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="8">
                                    <ToggleSwitch x:Name="AiDiagnosticsSensitiveToggle"
                                                  Header="Capture sensitive prompt and response content"
                                                  OffContent="Off"
                                                  OnContent="On"
                                                  Toggled="OnAiDiagnosticsSensitiveToggle"
                                                  AutomationProperties.Name="Capture sensitive prompt and response content for this session"/>
                                    <TextBlock Text="Warning: captured payloads may include private meeting or Microsoft 365 content. Capture is session-only, clears on app exit, and disabling it immediately removes previously captured payloads."
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AiDiagnosticsStatusText"
                                           Text="Loading AI diagnostics..."
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                <Button x:Name="AiDiagnosticsClearButton"
                                        Grid.Column="1"
                                        Content="Clear events"
                                        Click="OnAiDiagnosticsClearClick"
                                        AutomationProperties.Name="Clear AI diagnostic events"/>
                            </Grid>
                            <TextBlock x:Name="AiDiagnosticsAnnouncementText"
                                       Height="1"
                                       Opacity="0"
                                       IsHitTestVisible="False"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="AiDiagnosticsEmptyText"
                                       Text="No AI diagnostic events yet. Metadata appears when an AI or WorkIQ request starts."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                            <ListView x:Name="AiDiagnosticsList"
                                      Visibility="Collapsed"
                                      MaxHeight="460"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      AutomationProperties.Name="AI diagnostic event timeline">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Expander HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{Binding AutomationName}">
                                            <Expander.Header>
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Capability}"
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Duration}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProviderModel}"
                                                               TextWrapping="Wrap"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Status}"
                                                                   TextWrapping="Wrap"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding RequestLabel}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Spacing="6" Padding="0,6,0,4">
                                                <TextBlock Text="{Binding RequestIdentity}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Usage}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Quota}" TextWrapping="Wrap"/>
                                                <StackPanel Visibility="{Binding SensitivePayloadVisibility}"
                                                            Spacing="6">
                                                    <TextBlock Text="{Binding TruncationNotice}"
                                                               Visibility="{Binding TruncationVisibility}"
                                                               TextWrapping="Wrap"
                                                               Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                                    <TextBlock Text="Prompt" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                                    <TextBox Text="{Binding PromptPayload}"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             MaxHeight="180"
                                                             FontFamily="Cascadia Mono, Consolas"
                                                             AutomationProperties.Name="Captured prompt payload"/>
                                                    <TextBlock Text="Request" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                                    <TextBox Text="{Binding RequestPayload}"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             MaxHeight="180"
                                                             FontFamily="Cascadia Mono, Consolas"
                                                             AutomationProperties.Name="Captured request payload"/>
                                                    <TextBlock Text="Response" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                                    <TextBox Text="{Binding ResponsePayload}"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             MaxHeight="180"
                                                             FontFamily="Cascadia Mono, Consolas"
                                                             AutomationProperties.Name="Captured response payload"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Storage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6" Padding="0,4,0,8">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Notes folder" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                    <TextBlock Text="Where meeting notes are saved." Style="{StaticResource SettingsFieldDescriptionStyle}"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NotesPath"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1" Click="OnBrowseClick"
                                                ToolTipService.ToolTip="Browse for notes folder"
                                                AutomationProperties.Name="Browse for notes folder">
                                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xED25;" FontSize="16"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>

                    <InfoBar x:Name="InfoLabel"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Message="Settings are saved to %AppData%\MeetingCapture\settings.user.json."/>
                    <InfoBar x:Name="SaveStatus" IsOpen="False" IsClosable="True"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2"
                  Padding="16,10,16,12"
                  BorderThickness="0,1,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnSettingsCancelClick"/>
                    <Button x:Name="SaveButton" Content="Save"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSaveClick"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ════════════════ STATE 2: RECORDING ════════════════ -->
        <Grid x:Name="RecordingPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="RecordingBodyScroll"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="RecordingBody">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="RecordingOverviewScroll"
                          Grid.Row="0"
                          MaxHeight="320"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,10,16,10" Spacing="10">
                <TextBlock x:Name="RecordingTitleText" Text="Meeting notes" MaxLines="2"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:Name="TimeIndicator" Text="0 min elapsed"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="LifecycleText" TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel x:Name="RecordingAuthProgress" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="RecordingAuthProgressText" Text="WorkIQ sign-in in progress"
                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <Button x:Name="RecordingWorkIqCancelButton" Content="Cancel sign-in"
                            Visibility="Collapsed" Click="OnWorkIqCancelClick"/>
                </StackPanel>
                <Grid x:Name="RecordingNoticeHost" Visibility="Collapsed">
                    <InfoBar x:Name="RecordingNotice"
                             IsOpen="False"
                             IsClosable="True"
                             Severity="Informational"
                             Title="Transcription is on"
                             Message="Let everyone know this meeting is being transcribed."/>
                    <Button x:Name="CopyRecordingNoticeButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="0,8,48,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Canvas.ZIndex="1"
                            AutomationProperties.Name="Copy transcription notice"
                            ToolTipService.ToolTip="Copy transcription notice"
                            Click="OnCopyRecordingNoticeClick">
                        <FontIcon x:Name="CopyRecordingNoticeIcon"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE8C8;"
                                  FontSize="13"/>
                    </Button>
                </Grid>
                <Border x:Name="CurrentTopicSection"
                        Padding="14,12"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Current topic"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TldrChip" Text="Waiting for recognized speech..."
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   FontWeight="Normal"
                                   LineHeight="24"
                                   ToolTipService.ToolTip="{Binding Text, ElementName=TldrChip}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="SummaryStatusText" Text="Waiting for enough conversation."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="SummaryRetryButton" Content="Retry topics" Visibility="Collapsed"
                                HorizontalAlignment="Left" Click="OnSummaryRetryClick"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
                <Grid x:Name="InsightSections"
                      Grid.Row="1"
                      Margin="16,0,16,8"
                      RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Expander x:Name="OpenQuestionsExpander"
                          Grid.Column="0"
                          Grid.Row="0"
                          VerticalAlignment="Top"
                          IsExpanded="False"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          Style="{StaticResource RecordingInsightExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE897;" FontSize="13"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock x:Name="OpenQuestionsHeader"
                                       Grid.Column="1"
                                       Text="Questions (0 open, 0 done)"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="QuestionsStatusText" Text="Waiting for conversation."
                                   Style="{StaticResource RecordingStatusTextStyle}"/>
                        <Button x:Name="QuestionsRetryButton" Content="Retry questions"
                                Visibility="Collapsed" HorizontalAlignment="Left" Margin="12,0,12,8"
                                Click="OnQuestionsRetryClick"/>
                        <ScrollViewer x:Name="OpenQuestionsItemsScroll"
                                      MaxHeight="156"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="OpenQuestionsList"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="QuestionChecklistToggle"
                                                  Tag="{Binding}"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  Click="OnChecklistItemToggled"
                                                  MinWidth="0"
                                                  Padding="4,2"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  VerticalContentAlignment="Top"
                                                  AutomationProperties.Name="{Binding Text}">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="15"
                                                       LineHeight="22"
                                                       Opacity="{Binding TextOpacity}"
                                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletionTextDecorationsConverter}}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
                <Expander x:Name="ActionsExpander"
                          Grid.Column="0"
                          Grid.Row="1"
                          VerticalAlignment="Top"
                          IsExpanded="False"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                          Style="{StaticResource RecordingInsightExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE73E;" FontSize="13"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock x:Name="ActionsHeader"
                                       Grid.Column="1"
                                       Text="Actions (0 open, 0 done)"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ActionsStatusText" Text="Waiting for conversation."
                                   Style="{StaticResource RecordingStatusTextStyle}"/>
                        <Button x:Name="ActionsRetryButton" Content="Retry actions"
                                Visibility="Collapsed" HorizontalAlignment="Left" Margin="12,0,12,8"
                                Click="OnActionsRetryClick"/>
                        <ScrollViewer x:Name="ActionsItemsScroll"
                                      MaxHeight="156"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ActionsList"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="ActionChecklistToggle"
                                                  Tag="{Binding}"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  Click="OnChecklistItemToggled"
                                                  MinWidth="0"
                                                  Padding="4,2"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  VerticalContentAlignment="Top"
                                                  AutomationProperties.Name="{Binding Text}">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="15"
                                                       LineHeight="22"
                                                       Opacity="{Binding TextOpacity}"
                                                       TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletionTextDecorationsConverter}}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
                </Grid>
            <StackPanel x:Name="SpeakerSection" Grid.Row="2" Margin="16,2,16,6" Spacing="6">
                <Border x:Name="SpeakerNamingPanel"
                        Visibility="Collapsed"
                        Padding="12"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="SpeakerPromptTitleText"
                                           Text="Name speaker"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="SpeakerTargetText"
                                           Text="Speaker: Guest-1"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Cancel"
                                    Click="OnSpeakerNameCancelClick"
                                    VerticalAlignment="Top"/>
                        </Grid>
                        <AutoSuggestBox x:Name="SpeakerNameSearch"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="Search attendees or type a name"
                                        TextChanged="OnSpeakerNameSearchTextChanged"
                                        SuggestionChosen="OnSpeakerNameSuggestionChosen"
                                        QuerySubmitted="OnSpeakerNameQuerySubmitted"/>
                        <Button x:Name="SpeakerNameApply"
                                Content="Apply name"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnSpeakerNameApplyClick"/>
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SpeakerActivityText" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                               VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="CombineSpeakersButton" Grid.Column="1"
                            Content="Combine speakers"
                            Visibility="Collapsed"
                            Padding="10,3"
                            FontSize="13"
                            Click="OnCombineSpeakersClick"
                            ToolTipService.ToolTip="Merge two or more speakers into one"/>
                </Grid>
                <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SpeakerBalancePanel">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="24" Height="24"
                                                   VerticalAlignment="Center"
                                                   Initials="{Binding AvatarInitials}"
                                                   ProfilePicture="{Binding AvatarImage}"
                                                   AutomationProperties.Name="{Binding AvatarAccessibleName}"/>
                                    <Button Grid.Column="1" Tag="{Binding SpeakerId}" Click="OnSpeakerBalanceNameClick"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Stretch" ToolTipService.ToolTip="Rename this speaker label">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   FontSize="14"/>
                                    </Button>
                                    <local:SpeakerTimelineBar Grid.Column="2"
                                                              Spans="{Binding Spans}"
                                                              SegmentBrush="{Binding Brush}"
                                                              ToolTipService.ToolTip="{Binding TalkTimeText}"
                                                              AutomationProperties.Name="{Binding TalkTimeText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="RecordingUtilityActions"
                        Grid.Row="3"
                        Margin="16,2,16,4"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                <TextBlock x:Name="SavedPathText"
                           Text="Notes saved"
                           MaxWidth="180"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding Text, ElementName=SavedPathText}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="OpenSavedButton" Content="Open notes" Click="OnOpenSavedClick" IsEnabled="False"/>
                <Button x:Name="RetrySavedButton" Content="Retry AI" Click="OnRetrySavedClick" IsEnabled="False"/>
                <Button x:Name="CancelRetryButton" Content="Cancel AI retry" Click="OnCancelRetryClick" Visibility="Collapsed"/>
            </StackPanel>

            <Expander x:Name="TranscriptExpander"
                      Grid.Row="4"
                      Margin="16,4,16,12"
                      IsExpanded="True"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="Live transcript">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                        <FontIcon Glyph="&#xE8C1;"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  FontSize="14"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock x:Name="TranscriptHeaderText" Text="Live transcript"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Expander.Header>
                <Border Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    <StackPanel x:Name="TranscriptNavigation" Grid.Row="0" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                        <Button x:Name="EarlierButton" Content="Earlier" Click="OnEarlierClick"/>
                        <Button x:Name="LaterButton" Content="Later" Click="OnLaterClick"/>
                        <Button x:Name="LatestButton" Content="Latest" Click="OnLatestClick"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyStateLabel"
                               Grid.Row="1"
                               Text="Start a recording to see the live transcript here."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="16"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ListView x:Name="TranscriptList" Grid.Row="1" Visibility="Collapsed" MaxHeight="180"
                                  SelectionMode="None" IsItemClickEnabled="False"
                                  Loaded="OnTranscriptLoaded" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2" Padding="4,6,8,8"
                                          Opacity="{Binding Opacity}" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <PersonPicture x:Name="TranscriptSpeakerAvatar"
                                                       Width="28"
                                                       Height="28"
                                                       Margin="0,1,0,0"
                                                       VerticalAlignment="Top"
                                                       Initials="{Binding AvatarInitials}"
                                                       ProfilePicture="{Binding AvatarImage}"
                                                       AutomationProperties.Name="{Binding AvatarAccessibleName}"/>
                                        <Grid Grid.Column="1" RowSpacing="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="TranscriptSpeakerButton"
                                                        Tag="{Binding SpeakerId}"
                                                        Click="OnTranscriptSpeakerClick"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        MinWidth="0"
                                                        HorizontalAlignment="Left"
                                                        ToolTipService.ToolTip="Click to rename">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Speaker}"
                                                                   Foreground="{Binding SpeakerBrush}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontStyle="{Binding FontStyle}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                        <FontIcon Glyph="&#xE70F;"
                                                                  FontSize="9"
                                                                  Opacity="0.45"
                                                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                  VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock x:Name="TranscriptTimestampText"
                                                           Grid.Column="1"
                                                           Text="{Binding Timestamp}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </Grid>
                                            <TextBlock x:Name="TranscriptBodyText"
                                                       Grid.Row="1"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="15"
                                                       LineHeight="22"
                                                       FontStyle="{Binding FontStyle}"
                                                       IsTextSelectionEnabled="True"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Expander>
            </Grid>
            </ScrollViewer>

            <!-- Keep recording controls outside the scrollable body. -->
            <Grid x:Name="RecordingFooter" Grid.Row="1" Padding="16,10,16,8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StopButton"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        AutomationProperties.Name="Stop recording"
                        Click="OnStopClick">
                    <Grid Height="36">
                        <Border x:Name="StopCountdownFill"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="3"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="StopCountdownFillTransform" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock x:Name="StopButtonLabel" Text="Stop" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button x:Name="NewRecordingButton" Grid.Column="0" Grid.Row="0" Content="New recording" Click="OnStartClick"
                        Visibility="Collapsed" IsEnabled="False" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Start a new recording"/>
                <Button x:Name="BackToMeetingsButton" Grid.Column="1" Grid.Row="0" Content="Back to meetings"
                        Click="OnBackToMeetingsClick" Visibility="Collapsed"/>
                <TextBlock x:Name="NewRecordingHint" Grid.Row="2" Grid.ColumnSpan="2"
                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="WhatDidIMissButton"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        MinHeight="40"
                        Padding="12,8"
                        ToolTipService.ToolTip="Open a catch-up recap of this recording"
                        AutomationProperties.Name="Catch me up on this recording"
                        Click="OnWhatDidIMissClick">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8BD;" FontSize="14"/>
                        <TextBlock Text="Catch me up" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                </Button>
                <Border x:Name="SaveDecisionPanel"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Grid.RowSpan="2"
                        Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DiscardRecordingButton"
                                Content="Discard"
                                AccessKey="D"
                                Click="OnDiscardRecordingClick"
                                AutomationProperties.Name="Discard recording and transcript"/>
                        <Button x:Name="SaveRecordingNowButton"
                                Grid.Column="1"
                                MinWidth="180"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AccessKey="S"
                                Click="OnSaveRecordingNowClick"
                                AutomationProperties.Name="Save recording now"
                                ToolTipService.ToolTip="Save immediately instead of waiting for automatic save">
                            <Grid Height="36">
                                <Border x:Name="SaveCountdownFill"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        CornerRadius="3"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="SaveCountdownFillTransform" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="SaveCountdownButtonLabel"
                                           Text="Save now"
                                           Margin="12,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Catch me up owns a visible result surface; it never overwrites Current topic. -->
            <Border x:Name="CatchUpPanel"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Margin="12,8,12,8"
                    Padding="16,14"
                    CornerRadius="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    AutomationProperties.Name="Catch me up">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Catch me up"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock x:Name="CatchUpSubtitleText"
                                       Text="What you missed, from this recording only."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="CatchUpCloseButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Top"
                                ToolTipService.ToolTip="Close catch me up"
                                AutomationProperties.Name="Close catch me up"
                                Click="OnCatchUpCloseClick">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE711;"
                                      FontSize="12"/>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="CatchUpProgress"
                                      Width="18"
                                      Height="18"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"/>
                        <TextBlock x:Name="CatchUpStatusText"
                                   Text="Preparing your catch-up..."
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="CatchUpRetryButton"
                                Visibility="Collapsed"
                                MinHeight="32"
                                Padding="10,4"
                                Content="Try again"
                                Click="OnWhatDidIMissClick"
                                AutomationProperties.Name="Try catch me up again"/>
                    </StackPanel>
                    <ScrollViewer x:Name="CatchUpScroll"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CatchUpBody" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Right now"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="CatchUpCurrentTopicText"
                                           Text="Topic not established yet."
                                           TextWrapping="Wrap"
                                           FontSize="16"
                                           LineHeight="24"/>
                            </StackPanel>
                            <TextBlock x:Name="CatchUpSummaryText"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                            <ItemsControl x:Name="CatchUpSectionsList"
                                          ItemTemplate="{StaticResource CatchUpSectionTemplate}"/>
                            <StackPanel x:Name="CatchUpSourcesSection" Spacing="4" Visibility="Collapsed">
                                <TextBlock Text="Related sources"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Suggestions from WorkIQ are not verified meeting facts."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ItemsControl x:Name="CatchUpSourcesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8" Padding="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"/>
                                                    <TextBlock Text="{Binding Metadata}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Tag="{Binding Url}"
                                                        Click="OnOpenContextSourceClick"
                                                        Width="36"
                                                        Height="36"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="Open externally"
                                                        AutomationProperties.Name="{Binding ExternalActionName}">
                                                    <FontIcon Glyph="&#xE8A7;"
                                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                              FontSize="13"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock x:Name="CatchUpGroundingText"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="TopicMapPanel"
                Grid.Row="1"
                Grid.Column="1"
                Visibility="Collapsed"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="VisualizationTitleText" Text="Topic map"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="VisualizationSubtitleText"
                                   Text="Live meeting · topics appear as they are accepted"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button x:Name="VisualizationExpandButton"
                            Grid.Column="1"
                            MinWidth="88"
                            Height="32"
                            Padding="8,0"
                            ToolTipService.ToolTip="Expand visualization to the window"
                            AutomationProperties.Name="Expand visualization to the window"
                            Click="OnVisualizationExpandClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="VisualizationExpandIcon"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE740;"
                                      FontSize="12"/>
                            <TextBlock x:Name="VisualizationExpandText"
                                       Text="Expand"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="VisualizationCloseButton"
                            Grid.Column="2" Width="32" Height="32" Padding="0"
                            ToolTipService.ToolTip="Close visualization"
                            AutomationProperties.Name="Close visualization"
                            Click="OnTopicMapCloseClick">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,6" ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GoToCurrentTopicButton"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Content="Go to current topic"
                            ToolTipService.ToolTip="Select the live topic and bring it into view"
                            AutomationProperties.Name="Go to current topic"
                            Click="OnGoToCurrentTopicClick"/>
                </Grid>
                <TextBlock x:Name="TopicMapStatusText"
                           Grid.Row="2" Margin="0,0,0,8"
                           Text="The visualization updates as topics are accepted."
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <Grid x:Name="TopicMapBodyGrid" Grid.Row="3" SizeChanged="OnTopicMapBodySizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TopicMapMainColumn" Width="3*" MinWidth="240"/>
                        <ColumnDefinition x:Name="TopicSplitterColumn" Width="Auto"/>
                        <ColumnDefinition x:Name="TopicNotesColumn" Width="2*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TopicMapMainRow" Height="*"/>
                        <RowDefinition x:Name="TopicNotesRow" Height="0"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TopicTimelineGuideText"
                               Margin="0,0,0,6"
                               Visibility="Collapsed"
                               Text="The meeting title branches to every topic, with grounded points, decisions, open questions and actions."
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid x:Name="TopicMapCombinedView"
                          Grid.Row="0"
                          Grid.Column="0"
                          RowSpacing="8"
                          AutomationProperties.Name="Whole-meeting topic map">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="TopicDetailColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    <TextBlock x:Name="TimelineEmptyText"
                                  Grid.Row="0"
                                  Grid.ColumnSpan="2"
                                  Visibility="Collapsed"
                                  Text="No topics yet. As topics are accepted, they will appear here in meeting order."
                                  TextWrapping="Wrap"
                                  MaxWidth="380"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid x:Name="BrainMapView"
                          Grid.Row="0"
                          Grid.Column="0"
                          SizeChanged="OnBrainMapViewSizeChanged"
                          AutomationProperties.Name="Whole-meeting topic map">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Enabled"
                                      x:Name="BrainMapScrollViewer">
                            <Grid>
                                <Canvas x:Name="BrainMapCanvas"
                                        MinWidth="320"
                                        MinHeight="280"
                                        AutomationProperties.Name="Whole-meeting topic branches and grounded details"/>
                                <TextBlock x:Name="BrainMapEmptyText"
                                           MaxWidth="420"
                                           Margin="24"
                                           Text="No connected topics yet. Grounded points and meeting details will appear here."
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </ScrollViewer>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="8"
                                Padding="8,4"
                                CornerRadius="8"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}">
                            <TextBlock x:Name="BrainMapNowText"
                                       Text="Now · waiting for a current topic"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       MaxWidth="240"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="TopicTimelineView"
                                  Grid.Row="0"
                                  Grid.ColumnSpan="2"
                                  Height="100"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  Visibility="Collapsed"
                                  AutomationProperties.Name="Topic selector">
                        <ItemsControl x:Name="TrailList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,4">
                                        <Button Tag="{Binding TopicId}"
                                                Click="OnVisualizationTopicClick"
                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                AutomationProperties.HelpText="{Binding Detail}"
                                                ToolTipService.ToolTip="{Binding AccessibleName}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Width="220"
                                                Height="84"
                                                HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"/>
                                                <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="10"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibleConverter}}"/>
                                                <Grid Padding="10,7" RowSpacing="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Label}"
                                                               MaxLines="1"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="WordEllipsis"
                                                               FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Row="1"
                                                                Orientation="Horizontal"
                                                                Spacing="6">
                                                        <Border Width="20" Height="20"
                                                                CornerRadius="10"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding Sequence}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="8"
                                                                Padding="6,2"
                                                                Visibility="{Binding IsRevisit, Converter={StaticResource BoolToVisibleConverter}}">
                                                            <TextBlock Text="Returned" FontSize="11"/>
                                                        </Border>
                                                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                                CornerRadius="8"
                                                                Padding="6,2"
                                                                VerticalAlignment="Top"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibleConverter}}">
                                                            <TextBlock Text="Now" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Border Grid.Row="2"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="8"
                                                            Padding="6,2"
                                                            HorizontalAlignment="Stretch"
                                                            Visibility="{Binding HasContextStatus, Converter={StaticResource BoolToVisibleConverter}}"
                                                            AutomationProperties.Name="{Binding ContextStatus.AccessibleName}">
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressRing Width="12"
                                                                          Height="12"
                                                                          IsActive="{Binding ContextStatus.IsLoading}"
                                                                          Visibility="{Binding ContextStatus.IsLoading, Converter={StaticResource BoolToVisibleConverter}}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ContextStatus.Text}"
                                                                       FontSize="11"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="TopicDetailPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Margin="8,0,0,0"
                            Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                    <ScrollViewer x:Name="TopicDetailView"
                                  VerticalScrollBarVisibility="Auto"
                                  IsTabStop="True"
                                  AutomationProperties.Name="Selected topic details">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="TopicBriefEmptyText"
                                       Text="Select a topic to see its grounded evidence and related details."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel x:Name="TopicBriefContent" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="2">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TopicBriefTitleText"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   TextWrapping="Wrap"/>
                                        <Border x:Name="TopicBriefCurrentBadge"
                                                Grid.Column="1"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="Now" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="TopicBriefDetailText"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TopicBriefDiscussedAtText"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TopicBriefAnalysisText"
                                               Text="Still analyzing the current topic. Grounded details below will update as evidence is confirmed."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock Text="From this meeting"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="TopicBriefNoDetailsText"
                                           Text="No transcript details have been recorded for this topic yet."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="TopicBriefFactsSection" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="Established facts" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <ItemsControl x:Name="TopicBriefFactsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="3" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding EvidenceText}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True"/>
                                                    <TextBlock Text="{Binding Metadata}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="TopicBriefRelationshipsSection" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="Grounded relationships" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <ItemsControl x:Name="TopicBriefRelationshipsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="1" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="TopicBriefQuestionsSection" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="Open questions" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <ItemsControl x:Name="TopicBriefQuestionsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                    <FontIcon Glyph="&#xE897;" FontSize="12" Opacity="0.7" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextWrapping="Wrap"
                                                               TextDecorations="{Binding Answered, Converter={StaticResource CompletionTextDecorationsConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="TopicBriefActionsSection" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="Actions and decisions" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <ItemsControl x:Name="TopicBriefActionsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Opacity="0.7" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               TextWrapping="Wrap"
                                                               TextDecorations="{Binding Completed, Converter={StaticResource CompletionTextDecorationsConverter}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="TopicBriefDecisionsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                    <FontIcon Glyph="&#xE930;" FontSize="12" Opacity="0.7" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="TopicBriefSourcesSection" Spacing="4" Visibility="Collapsed">
                                    <TextBlock Text="Related workplace suggestions" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="Suggestions—not meeting evidence"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Border x:Name="TopicBriefContextStatus"
                                            HorizontalAlignment="Stretch"
                                            Padding="8,6"
                                            CornerRadius="8"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            Visibility="Collapsed"
                                            AutomationProperties.LiveSetting="Polite">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ProgressRing x:Name="TopicBriefContextProgress"
                                                              Width="14"
                                                              Height="14"
                                                              IsActive="False"
                                                              Visibility="Collapsed"/>
                                                <TextBlock x:Name="TopicBriefContextStatusText"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                                            </StackPanel>
                                            <Button x:Name="TopicBriefContextActionButton"
                                                    Content="Find related work"
                                                    Click="OnRelatedContextRefreshClick"
                                                    HorizontalAlignment="Left"
                                                    Visibility="Collapsed"
                                                    AutomationProperties.Name="Find or retry related workplace suggestions"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl x:Name="TopicBriefSourcesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        Margin="0,0,0,8"
                                                        Padding="10,8"
                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="{Binding Glyph}" FontSize="13" Opacity="0.75" VerticalAlignment="Top"/>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Snippet}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Timestamp}"
                                                                       Visibility="{Binding HasTimestamp, Converter={StaticResource BoolToVisibleConverter}}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding RelevanceText}"
                                                                       TextWrapping="Wrap"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <TextBlock Text="{Binding InvolvementText}"
                                                                       TextWrapping="Wrap"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                                            <Button Content="Open source"
                                                                    Tag="{Binding SourceUrl}"
                                                                    Click="OnOpenContextSourceClick"
                                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibleConverter}}"
                                                                    HorizontalAlignment="Left"
                                                                    AutomationProperties.Name="{Binding OpenActionName}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TopicBriefSourcesOverflowText"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
                    </Grid>
                    <local:PaneSplitter x:Name="TopicPaneSplitter"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="12"
                                        Background="Transparent"
                                        AutomationProperties.Name="Resize topic map and meeting notes"
                                        ToolTipService.ToolTip="Drag to resize topic map and meeting notes">
                        <Rectangle Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    </local:PaneSplitter>
                    <ScrollViewer x:Name="MeetingNotesView"
                                  Grid.Row="0"
                                  Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,12,18,12"
                                  AutomationProperties.Name="Meeting notes by topic">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Meeting notes"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock x:Name="MeetingNotesWorkIqStatusText"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="MeetingNotesWorkIqSignInButton"
                                    Content="Sign in to Work IQ"
                                    Click="OnWorkIqSignInClick"
                                    Visibility="Collapsed"/>
                            <TextBlock x:Name="MeetingNotesEmptyText"
                                       Text="No accepted topics yet. Meeting notes will appear as topics are accepted."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="MeetingNotesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="7" Margin="0,0,0,14">
                                            <Border x:Name="MeetingNotesHeading"
                                                    Tag="{Binding Id}"
                                                    Padding="8,6"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Heading}"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1"
                                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                            CornerRadius="8"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibleConverter}}">
                                                        <TextBlock Text="Now" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Tag="{Binding Id}"
                                                            Width="28" Height="28" Padding="0"
                                                            VerticalAlignment="Center"
                                                            Click="OnNotesTopicToggleClick"
                                                            AutomationProperties.AutomationId="NotesTopicToggle"
                                                            AutomationProperties.Name="{Binding ToggleName}"
                                                            ToolTipService.ToolTip="{Binding ToggleName}">
                                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                  Glyph="{Binding ToggleGlyph}"
                                                                  FontSize="12"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="7"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibleConverter}}">
                                            <ItemsControl ItemsSource="{Binding Bullets}"
                                                          Visibility="{Binding HasBullets, Converter={StaticResource BoolToVisibleConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8" Margin="8,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="12"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="•"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="20"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No transcript-grounded summary is available for this topic."
                                                       Margin="8,0,0,0"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasNoBullets, Converter={StaticResource BoolToVisibleConverter}}"/>
                                            <StackPanel Spacing="5"
                                                        Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibleConverter}}">
                                                <TextBlock Text="Suggestions from Work IQ — not from this meeting"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <ItemsControl ItemsSource="{Binding Suggestions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="8" Margin="8,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon Glyph="{Binding Glyph}"
                                                                         FontSize="14"
                                                                         Margin="0,3,0,0"
                                                                         VerticalAlignment="Top"
                                                                         ToolTipService.ToolTip="{Binding SourceType}"
                                                                         AutomationProperties.Name="{Binding SourceType}"/>
                                                                <HyperlinkButton Grid.Column="1"
                                                                        Tag="{Binding SourceUrl}"
                                                                        Click="OnOpenContextSourceClick"
                                                                        IsEnabled="{Binding CanOpen}"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        ToolTipService.ToolTip="{Binding SourceType}"
                                                                        AutomationProperties.Name="{Binding OpenActionName}">
                                                                    <TextBlock Text="{Binding Title}"
                                                                              TextWrapping="Wrap"
                                                                              FontWeight="SemiBold"/>
                                                                </HyperlinkButton>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Shared InfoBars (Row 2) ─────────────────────────────────── -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="16,0,16,8">
            <InfoBar x:Name="MeetingPrompt"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"
                     Title="Take notes for this meeting?">
                <InfoBar.Content>
                    <StackPanel Spacing="7" HorizontalAlignment="Stretch" MaxWidth="380" Margin="0,4,0,8">
                        <TextBlock x:Name="MeetingPromptSubject"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   AutomationProperties.Name="Detected meeting or application"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="MeetingPromptSource"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Calendar connection and match status"/>
                        <TextBlock x:Name="MeetingPromptSchedule"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="Scheduled meeting time"/>
                        <TextBlock x:Name="MeetingPromptOrganizer"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="Meeting organizer"/>
                        <TextBlock x:Name="MeetingPromptInvitees"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="Meeting invitees"/>
                        <Button x:Name="TakeNotesButton"
                                Content="Take notes for this meeting"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Take notes for the detected meeting"
                                Click="OnTakeNotesClick"/>
                        <Button x:Name="ChooseCalendarMeetingButton"
                                Content="Choose a meeting"
                                Click="OnChooseCalendarMeetingClick"
                                AutomationProperties.Name="Choose a meeting from the calendar"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <InfoBar x:Name="MeetingEndPrompt"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"
                     Title="The Teams meeting appears to have ended."
                     Message="Stop recording?"
                     AutomationProperties.LiveSetting="Assertive">
                <InfoBar.ActionButton>
                    <Button x:Name="MeetingEndStopButton"
                            Content="Stop and save"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Stop and save the recording"
                            Click="OnMeetingEndStopClick"/>
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <Button x:Name="MeetingEndKeepButton"
                            Content="Keep recording"
                            Margin="0,4,0,8"
                            AutomationProperties.Name="Keep recording"
                            Click="OnMeetingEndKeepClick"/>
                </InfoBar.Content>
            </InfoBar>

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"/>
        </Grid>
    </Grid>
</Window>
